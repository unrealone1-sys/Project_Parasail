# Python
__pycache__/
*.py[cod]
.pytest_cache/

# virtual environments
.venv/

# Node (ParaSail_Paper build tooling)
node_modules/

# bundled AI model weights (~3 GB) - see parasail/scripts/export_model.py
/parasail/models/

# runtime caches (weather, translations, assistant model selection)
/parasail/.cache/

# Python build artifacts
*.egg-info/

# editor / OS junk
~$*
Thumbs.db
.DS_Store

# local-only operational notes (tailnet URL/IP, admin-key prefix) - never publish
LOCAL_SECRETS.md

# session handoff log - owner decision 2026-09-15: stays on this machine, never in the repo
PROJECT_CONTEXT.md

# deck render scratch (QA previews, extracted text)
ParaSail_Paper/.cache_render/

# habitat-model training artifacts (regenerate with scripts/train_habitat.py)
parasail/data/habitat_training_*.csv
parasail/data/habitat_metrics.json

# agent tool state
.zcode/
